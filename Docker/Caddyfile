# Caddyfile para CongresoMx
#
# Reemplaza congresomx.example.com por tu dominio real. Caddy gestiona los
# certificados Let's Encrypt automaticamente cuando el dominio resuelve al
# IP del servidor.
#
# Para activar en local sin dominio, usa ":80" en vez del nombre.

# Bloque global: debe ir PRIMERO en el archivo.
{
    email jorgepi@pi-solutions.tech
    # Para testing, descomenta para usar staging de Let's Encrypt:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

congresomx.example.com {
    log {
        output stdout
        format json
        level INFO
    }

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # WebSocket pasa por la misma ruta /Ws/Asistencias. Caddy maneja el
    # upgrade HTTP -> WS transparentemente con reverse_proxy.
    reverse_proxy AppApi:8000 {
        transport http {
            read_timeout 1h
            write_timeout 1h
        }
    }
}
