# Entorno
EnvName=Local
LogLevel=INFO
Timezone=America/Mexico_City

# Base de datos MariaDB
DatabaseUrl=mysql+asyncmy://CongresoMx:CongresoMxPass@127.0.0.1:3306/CongresoMx?charset=utf8mb4
DatabaseEcho=false

# Credenciales para el contenedor MariaDB (consumidas por DockerCompose.yml)
MariadbRootPassword=ChangeMeRootPass
MariadbDatabase=CongresoMx
MariadbUser=CongresoMx
MariadbPassword=CongresoMxPass

# Redis
RedisUrl=redis://127.0.0.1:6379/0

# API
ApiKey=ChangeMeApiKey
ApiHost=0.0.0.0
ApiPort=8000

# Scraping
UserAgent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
RateLimitPerHostPerSec=1
HttpTimeoutSec=30
HttpMaxRetries=3
